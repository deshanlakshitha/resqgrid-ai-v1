# =============================================================================
# ResQGrid AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to version control.
# =============================================================================

# ---- Application ----
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-string
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=resqgrid
POSTGRES_PASSWORD=resqgrid_dev_password
POSTGRES_DB=resqgrid_ai
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ---- JWT Authentication ----
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Alibaba Cloud Model Studio / Qwen AI ----
DASHSCOPE_API_KEY=your-dashscope-api-key
MODEL_STUDIO_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_STUDIO_MODEL=qwen-plus

# ---- Alibaba Cloud OSS (Object Storage) ----
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_BUCKET=resqgrid-evidence
OSS_REGION=ap-southeast-1
OSS_ENDPOINT=https://oss-ap-southeast-1.aliyuncs.com

# ---- Map Provider ----
# Real Google Maps (recommended): create a key at
# https://console.cloud.google.com/apis/credentials, enable "Maps JavaScript
# API", and paste it below (also set it in apps/web/.env.local for local dev).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Fallback basemap when no Google key is set: OpenFreeMap — free, no key, no limits.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Notifications (Optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@resqgrid.local

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json
