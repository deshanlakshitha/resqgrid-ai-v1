# =============================================================================
# ResQGrid AI — Web Frontend Environment (apps/web)
# =============================================================================
# Copy this file to .env.local and restart `npm run dev` after changes:
#   copy .env.example .env.local

# ---- Real Google Maps (recommended for the full experience) ----
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an API key (or use an existing one)
# 3. Enable the "Maps JavaScript API" for that key (APIs & Services > Library)
# 4. Paste the key below
# The command-center map and the incident location picker will use real
# Google Maps with a dark command-center style. Without a key (or if the key
# is rejected) the app automatically falls back to the free OpenFreeMap
# dark basemap — no key, no cost, still a real detailed map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Backend API ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---- MapLibre fallback basemap (ignored when the Google key above is set) ----
# Free OpenFreeMap styles: dark, liberty, bright, positron
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
